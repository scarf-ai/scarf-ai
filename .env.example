# EXAMPLE ONLY. Copy to .env next to package.json and fill in your own values. Never commit .env.
# Empty = the example default in src/config.ts / src/index.ts. Budgets, limits and thresholds are yours to set.
# Secrets (tokens, keys, passwords) live only on your server or PC.

# Optional — see src/config.ts for what it does.
